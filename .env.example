# Example environment variables template
# Example values only. Set these in your process environment; Django does not load .env files.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-for-local-use
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# For production only, set a positive value after HTTPS is fully configured.
DJANGO_SECURE_HSTS_SECONDS=0
