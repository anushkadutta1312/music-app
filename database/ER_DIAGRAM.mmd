        VARCHAR image_url
        VARCHAR external_provider
        VARCHAR external_artist_id
        DATETIME created_at
        DATETIME updated_at
    }
    CATALOG_SONG {
        INTEGER id PK
        VARCHAR title
        VARCHAR album_name
        INTEGER duration_seconds
