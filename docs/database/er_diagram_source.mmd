erDiagram
    AUTH_USER ||--|| ACCOUNTS_USERPROFILE : "has profile (1:1)"
    AUTH_USER ||--o{ PLAYLISTS_PLAYLIST : "owns (1:M)"
    AUTH_USER ||--o{ PROFILES_FAVOURITE : "favourites (1:M)"

    CATALOG_SONG ||--o{ PROFILES_FAVOURITE : "favourited in (1:M)"
    CATALOG_SONG ||--o{ CATALOG_SONGARTIST : "performed by (1:M)"
    CATALOG_ARTIST ||--o{ CATALOG_SONGARTIST : "performs (1:M)"

    CATALOG_SONG ||--o{ CATALOG_SONGGENRE : "categorized as (1:M)"
    CATALOG_GENRE ||--o{ CATALOG_SONGGENRE : "categorizes (1:M)"

    PLAYLISTS_PLAYLIST ||--o{ PLAYLISTS_PLAYLISTSONG : "contains (1:M)"
    CATALOG_SONG ||--o{ PLAYLISTS_PLAYLISTSONG : "included in (1:M)"

    AUTH_USER {
        int id PK
        string username UK
        string email
        string password
        boolean is_staff
        datetime date_joined
    }

    ACCOUNTS_USERPROFILE {
        int id PK
        int user_id FK,UK
        string display_name
        text bio
        string profile_image
        string role "ADMIN | MEMBER"
        datetime created_at
        datetime updated_at
    }

    CATALOG_GENRE {
        int id PK
        string name UK
        text description
        datetime created_at
    }

    CATALOG_ARTIST {
        int id PK
        string name UK
        text biography
        string image_url
        string external_provider
        string external_artist_id
        datetime created_at
        datetime updated_at
    }

    CATALOG_SONG {
        int id PK
        string title
        string album_name
        int duration_seconds "CHECK > 0"
        int release_year "CHECK >= 1900"
        string cover_image_url
        string external_provider
        string external_track_id
        datetime created_at
        datetime updated_at
    }

    CATALOG_SONGARTIST {
        int id PK
        int song_id FK
        int artist_id FK
        string role "DEFAULT 'Primary'"
    }

    CATALOG_SONGGENRE {
        int id PK
        int song_id FK
        int genre_id FK
    }

    PROFILES_FAVOURITE {
        int id PK
        int user_id FK
        int song_id FK
        datetime created_at
    }

    PLAYLISTS_PLAYLIST {
        int id PK
        int owner_id FK
        string title
        text description
        string cover_image_url
        boolean is_public "DEFAULT False"
        datetime created_at
        datetime updated_at
    }

    PLAYLISTS_PLAYLISTSONG {
        int id PK
        int playlist_id FK
        int song_id FK
        int position "CHECK >= 1"
        datetime added_at
    }
